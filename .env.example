# Required production values. Do not commit the real .env file.
DB_NAME=aichecker
DB_USER=aichecker
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Public/local ports
FRONTEND_PORT=3000
API_PORT=5000
AI_DRIVER_PORT=8000
POSTGRES_PORT=5432
ENABLED_MODELS=

# JWT
JWT_ISSUER=AiCheckerApiCore
JWT_AUDIENCE=AiCheckerFrontend
JWT_EXPIRY_MINUTES=60

# Cloud providers (add the configured ids to ENABLED_MODELS)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SBERGPT_API_KEY=
SBERGPT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1/
SBERGPT_MODEL=GigaChat-Pro

# Universal local provider. managed mounts LOCAL_LLM_MODELS_DIR read-only;
# external uses an existing OpenAI-compatible /v1 endpoint and skips local-llm.
ENABLE_LOCAL_LLM=false
LOCAL_LLM_MODE=managed
LOCAL_LLM_MODELS_DIR=./models
LOCAL_LLM_MODEL_FILE=model.gguf
LOCAL_LLM_MODEL_URL=
LOCAL_LLM_MODEL_SHA256=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONTEXT_SIZE=8192
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_THREADS=8
LOCAL_LLM_BATCH_SIZE=512
LOCAL_LLM_PARALLEL=1

# Safety and capacity
ALLOW_PROGRAMMATIC_FALLBACK=false
MAX_REQUEST_SIZE_MB=100
MAX_FILE_SIZE_MB=50
MAX_RESPONSE_FILE_COUNT=50
ANALYSIS_QUEUE_CAPACITY=20
ANALYSIS_MAX_ATTEMPTS=3
AI_PROVIDER_TIMEOUT_SECONDS=360
AI_PIPELINE_TIMEOUT_SECONDS=1200
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_INPUT_CHARS=4000
